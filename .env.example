# ---------------------------------------------------------------
# TravelPipa — environment variables
# Copy to .env for local development:  cp .env.example .env
# On Railway, set these in the service "Variables" tab.
# ---------------------------------------------------------------

# Development: True. Production: False (always).
DEBUG=True

# Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Comma separated. In production SITE_URL already adds travelpipa.com.br and www.travelpipa.com.br.
ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (with https://) allowed to submit forms. Filled automatically from SITE_URL.
CSRF_TRUSTED_ORIGINS=

# Public address of the site, used in canonical URLs, sitemap and social sharing.
# Production: https://travelpipa.com.br  (www. and the Railway address redirect to it)
SITE_URL=http://localhost:8000

# Proxies in front of the app (Railway = 1; Railway + Cloudflare orange cloud = 2)
TRUSTED_PROXY_COUNT=1

# Team management panel ("Gestão TravelPipa")
PANEL_URL=gestao/
PANEL_LOGIN_MAX_ATTEMPTS=5
PANEL_LOGIN_LOCK_MINUTES=15

# Technical Django admin (create users, permissions). Avoid the obvious /admin/.
ADMIN_URL=painel/

# PostgreSQL in production (Railway fills DATABASE_URL automatically when you add a Postgres service).
# Leave empty to use SQLite in development.
DATABASE_URL=

# Uploaded photos. On Railway mount a volume and point MEDIA_ROOT to it, e.g. /data/media
MEDIA_ROOT=
# Serve uploaded files through Django (True on Railway when no external storage/CDN is used)
SERVE_MEDIA=

# E-mail notifications. Railway blocks SMTP on Free/Hobby plans, so production uses
# Resend (resend.com, HTTPS API, free tier). Without a key, requests are saved but no e-mail is sent.
RESEND_API_KEY=
# SMTP alternative (servers that allow SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=TravelPipa <suporte@travelpipa.com.br>
# Who receives new booking notifications (comma separated). Empty = e-mail set in the admin panel.
NOTIFICATION_EMAILS=suporte@travelpipa.com.br
# Who receives an e-mail when the site has an error (500)
ERROR_EMAILS=suporte@travelpipa.com.br

# First panel user, created on the first start when no admin exists.
# Remove DJANGO_SUPERUSER_PASSWORD after the first deploy.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=suporte@travelpipa.com.br

# Anti-spam
FORM_RATE_LIMIT_PER_HOUR=8
FORM_MIN_FILL_SECONDS=3

# HTTPS hardening (production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=2592000

# Tides & weather page (/en/tides-and-weather/, /pt-br/mare-e-tempo/, /es/mareas-y-clima/)
# Weather: MET Norway (free, commercial use allowed). Their terms ask for a contact
# in the requests' User-Agent: put the agency's e-mail or website here.
WEATHER_ENABLED=True
WEATHER_CONTACT=suporte@travelpipa.com.br
# Tides. Default "tabuamare": Tábua de Maré API (tabuamare.api.br), free, with the
# Brazilian Navy (DHN) predictions for the nearest port (Natal). Works without a key;
# a free key (login at tabuamare.api.br) gives the site its own quota (32,000 req/month).
# "worldtides" is a paid alternative (needs WORLDTIDES_API_KEY).
TIDES_PROVIDER=tabuamare
TIDES_STATE=rn
TABUAMARE_API_KEY=
WORLDTIDES_API_KEY=
# Point used for weather, sun and tides (default: Praia da Pipa)
CONDITIONS_LAT=-6.2283
CONDITIONS_LON=-35.0464

# Google reviews on the site (Places API (New) key, restricted to that API). Optional.
GOOGLE_PLACES_API_KEY=

# Test environment only (branch model): hides the site from Google and shows a banner
STAGING=False

# Mercado Pago Checkout Pro: online payment of the 10% deposit (Pix, card, boleto).
# Local and branch model: TEST access token. Live site (main): PRODUCTION access token.
# Without it the "Pay the deposit" button is hidden. Never commit the real value.
MERCADOPAGO_ACCESS_TOKEN=
# Optional: secret of the Mercado Pago webhook (Your integrations > Webhooks) to check signatures.
MERCADOPAGO_WEBHOOK_SECRET=
# Deposit percentage (default 10).
DEPOSIT_PERCENT=10
