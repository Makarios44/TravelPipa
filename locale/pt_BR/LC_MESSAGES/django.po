#: templates/core/contact.html:4
msgid ""
"Contact TravelPipa in Praia da Pipa, Brazil, by WhatsApp, e-mail or "
"Instagram. We answer in English, Portuguese and Spanish."
msgstr ""
"Fale com a TravelPipa, na Praia da Pipa (RN), por WhatsApp, e-mail ou "
"Instagram. Atendemos em português, inglês e espanhol."

